{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "klangbild@ennortix",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "videodelay.js", "ambilight.js", "dialog.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Klangbild",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Klangbild",
    "default_panel": "popup/popup.html?sidebar",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "web_accessible_resources": [
    {
      "resources": ["dialog.js", "dialog-worklet.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdOpen__"
    },
    "_execute_sidebar_action": {
      "description": "__MSG_cmdSidebar__"
    },
    "speed-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "__MSG_cmdSpeedUp__"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "__MSG_cmdSpeedDown__"
    },
    "delay-up": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "__MSG_cmdDelayUp__"
    },
    "delay-down": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "__MSG_cmdDelayDown__"
    },
    "toggle-fx": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "__MSG_cmdToggleFx__"
    },
    "loop": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "__MSG_cmdLoop__"
    },
    "screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdScreenshot__"
    },
    "speed-reset": {
      "description": "__MSG_cmdSpeedReset__"
    },
    "seek-back": {
      "description": "__MSG_cmdSeekBack__"
    },
    "seek-forward": {
      "description": "__MSG_cmdSeekForward__"
    },
    "volume-up": {
      "description": "__MSG_cmdVolumeUp__"
    },
    "volume-down": {
      "description": "__MSG_cmdVolumeDown__"
    }
  }
}
