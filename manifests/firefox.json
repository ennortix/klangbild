{
  "manifest_version": 3,
  "name": "Klangbild – Live Audio & Video Editing",
  "version": "1.0.0",
  "description": "Edit audio and video on any website in real time: speed, A/V sync, equalizer, volume boost, picture filters and more.",
  "browser_specific_settings": {
    "gecko": {
      "id": "klangbild@ennortix",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "videodelay.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Klangbild",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Open the Klangbild panel"
    },
    "speed-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Faster (+0.25×)"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Slower (−0.25×)"
    },
    "delay-up": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "Audio delay +10 ms"
    },
    "delay-down": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "Audio delay −10 ms"
    },
    "toggle-fx": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "All effects on/off"
    },
    "loop": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "A-B loop: set A → set B → off"
    },
    "screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save a screenshot of the video"
    }
  }
}
